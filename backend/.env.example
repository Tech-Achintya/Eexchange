# ============================================================
# Eexchange — .env.example
# ============================================================
# NOTE:
# Spring Boot reads OS/IDE environment variables, not this file directly.
# Docker Compose reads only the LOCAL_* values below.
# Copy these keys into your OS/IDE environment and fill in real values.
#
# Choose exactly one profile:
#   local -> Docker PostgreSQL + Redis (backend/docker-compose.yml)
#   prod  -> Supabase + Upstash
# ============================================================

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=local

# --- Server ---
SERVER_PORT=8080

# ============================================================
# LOCAL infrastructure (Docker Compose + application-local.properties)
# ============================================================
LOCAL_DB_NAME=eexchange
LOCAL_DB_USER=eexchange_user
LOCAL_DB_PASSWORD=local_dev_password
LOCAL_DB_PORT=5432

LOCAL_REDIS_PASSWORD=local_redis_password
LOCAL_REDIS_PORT=6379

# Local-only URLs
APP_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# PRODUCTION infrastructure (Supabase + Upstash)
# Used only when SPRING_PROFILES_ACTIVE=prod.
# Set these in AWS (environment variables / Secrets Manager),
# never commit real values.
# ============================================================
# DB_HOST=your-project.supabase.co
# DB_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_supabase_password_here
# DB_SSLMODE=require
#
# REDIS_HOST=your-endpoint.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_password_here
# REDIS_TIMEOUT=2s
# REDIS_CONNECT_TIMEOUT=2s
# REDIS_SSL=true
#
# APP_PASSWORD_RESET_BASE_URL=https://your-domain.example/reset-password
# APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example

# --- JWT ---
# Generate each with: openssl rand -base64 48
APP_JWT_SECRET=your_jwt_secret_min_32_chars_base64
APP_ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_chars_base64
APP_JWT_EXPIRY_MS=36000000
APP_ADMIN_JWT_EXPIRY_MS=7200000

# --- Email (Brevo) ---
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email_here
BREVO_SENDER_NAME=EExchange

# --- Login lockout ---
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCKOUT_SECONDS=900

# --- OTP ---
APP_OTP_TTL_SECONDS=600
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_COOLDOWN_SECONDS=60
APP_OTP_HOURLY_MAX=5

# --- Password reset ---
APP_PASSWORD_RESET_TTL_SECONDS=900
APP_PASSWORD_RESET_COOLDOWN_SECONDS=60
APP_PASSWORD_RESET_HOURLY_MAX=5

# --- Rate limiting ---
APP_SECURITY_AUTH_RATE_LIMIT_PER_MINUTE=60

# --- Redis college feed cache ---
# Default feed TTL (1 hour). Entries expire sooner when a post expires sooner.
FEED_CACHE_DEFAULT_TTL_SECONDS=3600
# Pages with a post expiring in less than this are not cached.
FEED_CACHE_MIN_TTL_SECONDS=60
# Stampede-prevention fill lock.
FEED_CACHE_FILL_LOCK_TTL_SECONDS=5

# --- Admin bootstrap (used only when the admins table is empty) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change_me_strong_password

# --- S3 image storage (required in every profile) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_bucket_name
S3_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=https://your_bucket_name.s3.us-east-1.amazonaws.com

# --- Posts ---
APP_POST_EXPIRY_DAYS=60
APP_POST_MAX_IMAGES=5
# Lifetime edits before the post is frozen in MANUAL_REVIEW.
APP_POST_MAX_EDITS_BEFORE_MANUAL_REVIEW=5

# --- AI moderation (OpenRouter) ---
# provider: openrouter (default) | stub (local development only)
MODERATION_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here
# NVIDIA Nemotron 3.5 Super VL multimodal vision-language model
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODERATION_DAILY_BUDGET=45
# MODERATION_MAX_ATTEMPTS=3
# MODERATION_JOB_BATCH_SIZE=5
# Escalating waits (minutes) for failed attempt 1, 2, 3; the last value is reused.
# MODERATION_BACKOFF_MINUTES=5,15,60
