# ============================================================
# Eexchange — .env.example  (SAFE TO COMMIT — no real secrets)
# ============================================================
# Copy this to .env and fill in real values before running.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=eexchange
POSTGRES_USER=eexchange_user
POSTGRES_PASSWORD=change_me

# --- Redis ---
REDIS_PASSWORD=change_me

# --- JWT ---
# Generate: openssl rand -base64 48
APP_JWT_SECRET=change_me_min_32_chars_base64
APP_JWT_EXPIRY_MS=36000000
APP_ADMIN_JWT_EXPIRY_MS=7200000

# --- Email (Brevo) ---
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender@email.com
BREVO_SENDER_NAME=EExchange
