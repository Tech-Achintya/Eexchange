# ============================================================
# Eexchange — Local Docker infrastructure overrides
# ============================================================
# Copy to .env.local (gitignored), then run:
#   docker compose --env-file .env.local up -d
#
# These values are consumed by docker-compose.yml and
# application-local.properties. They never touch production.
# ============================================================

LOCAL_DB_NAME=eexchange
LOCAL_DB_USER=eexchange_user
LOCAL_DB_PASSWORD=local_dev_password
LOCAL_DB_PORT=5432

LOCAL_REDIS_PASSWORD=local_redis_password
LOCAL_REDIS_PORT=6379
